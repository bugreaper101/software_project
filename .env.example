# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/[your-project]/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: If these variables are not set, the app will run in demo mode
# with all database operations mocked. This is useful for local development
# without a Supabase instance.
